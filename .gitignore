# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# self_improve otomatik değişiklik-öncesi yedekleri — kaynak kod değil, üretilen veri
src/jarvis_yedekler/

# Elle alınan tek seferlik yedek dosyaları
*.bak_*

# SADECE proje kökündeki kullanıcı verisi (varsa) — src/jarvis/memory/ gibi
# gerçek kod paketlerini etkilemesin diye başına / koyduk
/memory/
/logs/
/config/api_keys.json
*.pem
*.key

# Self-improve sandbox log çıktıları — klasör yapısını .gitkeep ile koru, içeriği yok say
src/jarvis/self_improvement/sandbox/logs/*
!src/jarvis/self_improvement/sandbox/logs/.gitkeep
